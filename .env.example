# =============================================================================
# Amoga Mobile Application - Environment Variables Template (.env)
# Copy this file to .env (or .env.local) and populate with your own values.
# NEVER commit your actual .env file to Git or version control!
# =============================================================================

# --- Supabase Configuration ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --- API & Backend URL ---
EXPO_PUBLIC_API_URL=https://your-backend-domain.vercel.app
EXPO_PUBLIC_BACKEND_URL=https://your-backend-domain.vercel.app

# --- Mail / SMTP / IMAP Configuration (Client-side Expo Public) ---
EXPO_PUBLIC_MAIL_USER=your-email@domain.com
EXPO_PUBLIC_MAIL_PASS=your-email-password
EXPO_PUBLIC_SMTP_HOST=smtp.your-provider.com
EXPO_PUBLIC_SMTP_PORT=587
EXPO_PUBLIC_SMTP_USER=your-email@domain.com
EXPO_PUBLIC_SMTP_PASS=your-email-password
EXPO_PUBLIC_SMTP_SECURE=false
EXPO_PUBLIC_SMTP_REQUIRE_TLS=true
EXPO_PUBLIC_IMAP_HOST=imap.your-provider.com
EXPO_PUBLIC_IMAP_PORT=993
EXPO_PUBLIC_IMAP_USER=your-email@domain.com
EXPO_PUBLIC_IMAP_PASS=your-email-password
EXPO_PUBLIC_IMAP_SECURE=true

# --- Mail / SMTP / IMAP Configuration (Serverless / Node environment) ---
MAIL_USER=your-email@domain.com
MAIL_PASS=your-email-password
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
IMAP_HOST=imap.your-provider.com
IMAP_PORT=993
IMAP_USER=your-email@domain.com
IMAP_PASS=your-email-password
IMAP_SECURE=true

# --- CometChat Calling & WebRTC Configuration ---
EXPO_PUBLIC_COMETCHAT_APP_ID=your_cometchat_app_id
EXPO_PUBLIC_COMETCHAT_REGION=IN
EXPO_PUBLIC_COMETCHAT_AUTH_KEY=your_cometchat_auth_key
EXPO_PUBLIC_COMETCHAT_REST_API_KEY=your_cometchat_rest_api_key
COMETCHAT_REST_API_KEY=your_cometchat_rest_api_key
